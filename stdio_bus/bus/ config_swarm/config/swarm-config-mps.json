{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "MPS (Apple Silicon) swarm configuration for autoresearch.",
  "pools": [
    {
      "id": "mps-worker",
      "command": "echo",
      "args": [
        "placeholder"
      ],
      "instances": 1
    }
  ],
  "swarm": {
    "gpuIds": [
      0
    ],
    "experimentTimeout": 10,
    "lockTimeout": 10,
    "workDir": "../.."
  },
  "limits": {
    "max_input_buffer": 4194304,
    "max_output_queue": 16777216,
    "max_restarts": 10,
    "restart_window_sec": 120,
    "backpressure_timeout_sec": 120
  }
}
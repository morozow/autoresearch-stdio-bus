{
  "pools": [
    {
      "id": "acp-worker",
      "command": "npx",
      "args": [
        "@stdiobus/workers-registry",
        "acp-registry",
        "--custom-agents",
        "./stdio_bus/openai-agents.json",
        "--api-keys",
        "./stdio_bus/api-keys.json"
      ],
      "env": {},
      "instances": 1,
      "cwd": "../"
    },
    {
      "id": "swarm",
      "command": "uv",
      "args": [
        "run",
        "swarm.py"
      ],
      "env": {
        "DEVICE_BACKEND": "mps"
      },
      "instances": 1,
      "cwd": "../"
    }
  ]
}
{
  "$comment": "stdio_bus configuration for swarm coordinator. Launch with: ./stdio_bus --config stdio-bus-config.json",
  "pools": [
    {
      "id": "swarm-coordinator",
      "command": "node",
      "args": [
        "./dist/cli.js",
        "--config",
        "./swarm-config.json"
      ],
      "env": {
        "NODE_ENV": "production"
      },
      "instances": 1
    }
  ],
  "limits": {
    "max_input_buffer": 4194304,
    "max_output_queue": 16777216,
    "max_restarts": 10,
    "restart_window_sec": 120,
    "backpressure_timeout_sec": 120
  }
}
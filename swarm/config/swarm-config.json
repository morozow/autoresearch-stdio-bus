{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Example 4-GPU swarm configuration for autoresearch. See CONFIG.md for documentation.",
  "pools": [
    {
      "id": "gpu-worker",
      "command": "node",
      "args": [
        "./dist/worker/gpu-worker.js"
      ],
      "env": {},
      "instances": 4
    }
  ],
  "swarm": {
    "gpuIds": [
      0,
      1,
      2,
      3
    ],
    "agentModel": "claude-acp",
    "apiKeys": "${ANTHROPIC_API_KEY}",
    "experimentTimeout": 10,
    "lockTimeout": 10,
    "workDir": "../.."
  },
  "limits": {
    "max_input_buffer": 4194304,
    "max_output_queue": 16777216,
    "max_restarts": 10,
    "restart_window_sec": 120,
    "backpressure_timeout_sec": 120
  }
}